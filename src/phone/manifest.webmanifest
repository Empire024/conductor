{
  "name": "Conductor",
  "short_name": "Conductor",
  "id": "/",
  "start_url": "/#/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#01111f",
  "theme_color": "#01111f",
  "description": "Watch and steer this Conductor's agents from your phone.",
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "images", "accept": ["image/*", ".png", ".jpg", ".jpeg", ".webp", ".gif"] }]
    }
  },
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}

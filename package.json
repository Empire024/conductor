{
  "name": "conductor-desktop",
  "productName": "Conductor",
  "version": "0.1.3",
  "private": true,
  "author": "Conductor",
  "description": "A local-first orchestration workspace for coding agents",
  "repository": {
    "type": "git",
    "url": "https://github.com/Empire024/conductor.git"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never && node scripts/generate-update-manifest.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test scripts/live-acceptance-guard.test.mjs scripts/local-update-package.test.mjs scripts/repair-codex-workspace-owner.test.mjs scripts/claude-permission-acceptance-guard.test.mjs",
    "update:local": "node scripts/build-local-update.mjs",
    "test:local-update-package": "node --test scripts/local-update-package.test.mjs",
    "test:update-ui": "npm run build && node scripts/smoke-local-updates.mjs",
    "test:update-download": "npm run build && node scripts/smoke-local-update-download.mjs",
    "test:agent-contracts": "vitest run src/main/providers src/main/structured-sessions.test.ts src/main/structured-store.test.ts src/main/agent-artifacts.test.ts src/main/live-test-policy.test.ts src/main/live-runtime-budget.test.ts src/shared/structured-agent-reducer.test.ts && node --test scripts/live-acceptance-guard.test.mjs",
    "test:agent-ui": "npm run build && node scripts/smoke-structured-agents.mjs && node scripts/smoke-structured-agents.mjs --provider=claude",
    "test:composer-drafts": "npm run build && node scripts/smoke-composer-drafts.mjs && node scripts/smoke-composer-drafts.mjs --provider=claude",
    "test:composer-settings": "npm run build && node scripts/smoke-composer-settings.mjs",
    "test:change-history": "npm run build && node scripts/smoke-change-history.mjs",
    "test:agent-live": "node scripts/live-structured-codex.mjs",
    "smoke:ui": "node scripts/smoke-ui.mjs",
    "test:backlog": "npm run build && node scripts/smoke-backlog.mjs",
    "test:autoscroll": "node scripts/smoke-autoscroll.mjs",
    "test:tab-groups": "node scripts/smoke-tab-groups.mjs",
    "test:background-windows": "npm run build && node scripts/smoke-background-windows.mjs",
    "test:project-tasks": "npm run build && node scripts/smoke-project-task-dispatch.mjs",
    "test:steering": "npm run build && node scripts/smoke-steering.mjs",
    "test:claude-permissions": "npm run build && node scripts/smoke-claude-permissions.mjs",
    "test:perf-streaming": "npm run build && node scripts/perf-streaming.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "diff": "^8.0.2",
    "electron-updater": "^6.6.2",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.2",
    "node-pty": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "io.conductor.desktop",
    "publish": [
      {
        "provider": "github",
        "owner": "Empire024",
        "repo": "conductor",
        "releaseType": "release"
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.svg",
      "executableName": "Conductor"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Conductor",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Conductor-Setup-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "src/renderer/src/assets/providers/LICENSE",
        "to": "provider-icons-LICENSE.txt"
      }
    ]
  }
}
